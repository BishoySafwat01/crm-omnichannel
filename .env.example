PROJECT_NAME="CRM Omnichannel"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# PostgreSQL Configuration
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="crm_omnichannel"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@db:5432/crm_omnichannel"

# Redis Configuration
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"

# Meta Integration Configuration
META_PAGE_ID="your_meta_page_id_here"
META_PAGE_ACCESS_TOKEN="your_meta_page_access_token_here"
META_GRAPH_API_VERSION="v23.0"
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_WEBHOOK_VERIFY_TOKEN="meta_crm_webhook_verify_token_2026"

# Provider Switching & BeOn V3 Omnichannel Configuration
ENABLE_DIRECT_META=false
DEFAULT_PROVIDER="BEON"
BEON_API_KEY="your_beon_api_key_here"
BEON_API_BASE_URL="https://v3.api.beon.chat/api"
BEON_WEBHOOK_SECRET="your_beon_webhook_secret_here"
BEON_SYNC_INTERVAL_SECONDS=15

# ngrok Configuration
NGROK_AUTHTOKEN="your_ngrok_authtoken_here"
